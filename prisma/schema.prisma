// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String
  description String?
  longDescription String? @db.Text
  image       String?
  images      String[] // untuk multiple images
  technologies String[] // tech stack yang digunakan
  demoUrl     String?
  sourceUrl   String?
  status      ProjectStatus @default(COMPLETED)
  featured    Boolean  @default(false) // untuk highlight project tertentu
  views       Int      @default(0) // tracking views/popularity
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  
  @@map("projects")
}

model SocialLink {
  id       String @id @default(cuid())
  platform String // "github", "linkedin", "twitter", "email", dll
  url      String
  username String?
  
  @@map("social_links")
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  ARCHIVED
}

model Post {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  content     String      @db.Text
  excerpt     String?
  coverImage  String?
  status      PostStatus  @default(DRAFT)
  featured    Boolean     @default(false)
  type        PostType    @default(BLOG) // Tambah field ini
  viewCount   Int         @default(0)
  readingTime Int         @default(0) // dalam menit
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  categoryId String?
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       PostTag[]
  likes      Like[]

  @@map("posts")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String?  // untuk styling kategori
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  posts Post[]

  @@map("categories")
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  color     String?   // untuk styling tag
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  posts PostTag[]

  @@map("tags")
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

model Like {
  id           String   @id @default(cuid())
  ipAddress    String   // untuk tracking like tanpa user authentication
  userAgent    String?  // optional: untuk tracking device/browser
  createdAt    DateTime @default(now())

  // Relations
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([ipAddress, postId]) // Satu IP hanya bisa like sekali per post
  @@map("likes")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PostType {
  BLOG
  WRITING
}